# Server Configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_WEBHOOK_SECRET=your-webhook-secret-for-supabase-functions

# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
VERIFIED_FROM_EMAIL=no-reply@negotiate.solsignai.com
VERIFIED_FROM_NAME=SolSignAI Agent

# SendGrid Inbound Parse Configuration
INBOUND_PARSE_SECRET=your-inbound-parse-secret

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Notes:
# - SUPABASE_SERVICE_ROLE_KEY is used to bypass RLS policies for system operations
# - SUPABASE_WEBHOOK_SECRET is used to authenticate requests from Supabase webhooks
# - INBOUND_PARSE_SECRET is used to authenticate incoming email webhooks from SendGrid
# - VERIFIED_FROM_EMAIL must be a verified sender in SendGrid
# - GEMINI_API_KEY is obtained from Google AI Studio (https://makersuite.google.com/app/apikey)
